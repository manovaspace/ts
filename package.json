{
  "name": "manovaspace-ts",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "turbo build && changeset publish",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "^6.0.3",
      "next": "16.4.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/node": "^26.6.6",
      "@biomejs/biome": "^2.6.4",
      "tsup": "^9.0.0",
      "vitest": "^5.0.5",
      "@serwist/turbopack": "^9.5.13",
      "serwist": "^9.5.13",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1",
      "@sentry/nextjs": "^11.10.0"
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@sentry/cli",
    "@swc/core",
    "esbuild",
    "sharp"
  ]
}
